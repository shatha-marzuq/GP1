{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mithaq_docproc/output_schema.json",
  "title": "MITHAQ Document Processing Output (schema 1.0)",
  "description": "ناتج وكيل معالجة المستندات: Document -> Clean Text. يستهلكه وكيل التقسيم ووكيل الاسترجاع ووكيل التقارير.",
  "type": "object",
  "required": ["schema_version", "document", "stats", "pages", "items", "text"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "document": {
      "type": "object",
      "required": ["filename", "source_type", "page_count", "needs_review", "warnings"],
      "properties": {
        "filename": {"type": "string"},
        "source_type": {"enum": ["pdf", "docx"]},
        "sha256": {"type": ["string", "null"], "description": "بصمة الملف الأصلي (للتتبع)"},
        "page_count": {"type": "integer"},
        "processed_at": {"type": "string", "format": "date-time"},
        "needs_review": {"type": "boolean", "description": "true = فيه تحذير يحتاج مراجعة بشرية قبل الاعتماد على النص"},
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "message_ar"],
            "properties": {"code": {"type": "string"}, "message_ar": {"type": "string"}}
          }
        }
      }
    },
    "stats": {
      "type": "object",
      "properties": {
        "chars": {"type": "integer"}, "words": {"type": "integer"},
        "native_pages": {"type": "integer"}, "ocr_pages": {"type": "integer"},
        "failed_pages": {"type": "integer"}, "empty_pages": {"type": "integer"},
        "tables": {"type": "integer"}, "items": {"type": "integer"},
        "avg_quality": {"type": ["number", "null"]}, "avg_ocr_confidence": {"type": ["number", "null"]},
        "ocr_engine": {"type": ["string", "null"]}, "seconds": {"type": "number"}
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["page", "method", "text", "item_ids"],
        "properties": {
          "page": {"type": ["integer", "null"], "description": "ترتيب الصفحة في الملف (1-based). null لملفات Word بدون تحويل"},
          "method": {"enum": ["native", "ocr", "failed"]},
          "ocr_confidence": {"type": ["number", "null"]},
          "quality": {"type": ["number", "null"], "description": "0..1"},
          "warnings": {"type": "array", "items": {"type": "string"}},
          "item_ids": {"type": "array", "items": {"type": "string"}},
          "text": {"type": "string"}
        }
      }
    },
    "items": {
      "type": "array",
      "description": "عناصر المستند بالترتيب. هذا المدخل الأساسي لوكيل التقسيم.",
      "items": {
        "type": "object",
        "required": ["id", "type", "page", "text", "text_norm"],
        "properties": {
          "id": {"type": "string", "pattern": "^p\\d+-\\d+$", "description": "ثابت: p{page}-{n}"},
          "type": {"enum": ["heading", "paragraph", "list_item", "table"]},
          "page": {"type": ["integer", "null"]},
          "text": {"type": "string", "description": "نص وفيّ للأصل: يُستخدم في اقتباس المخالفة"},
          "text_norm": {"type": "string", "description": "نص مبسّط (بدون تشكيل، ألف موحدة، أرقام لاتينية): للبحث والـ embeddings"},
          "marker": {"type": ["string", "null"], "description": "علامة البند: 6.2.1 / أ / • / المادة 5"},
          "level": {"type": ["integer", "null"], "description": "عمق الترقيم: 6.2.1 = 3"},
          "bbox": {"type": ["array", "null"], "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
          "source": {"enum": ["native", "ocr", "failed"]},
          "confidence": {"type": ["number", "null"]},
          "table": {
            "type": "object",
            "description": "موجود فقط إذا type = table. الأعمدة من اليمين لليسار للجداول العربية.",
            "properties": {
              "n_rows": {"type": "integer"},
              "n_cols": {"type": "integer"},
              "header": {"type": ["array", "null"], "items": {"type": "string"}},
              "rows": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
              "continues": {"type": "string", "description": "id الجدول في الصفحة السابقة لو هذا تكملة له"}
            }
          }
        }
      }
    },
    "text": {"type": "string", "description": "النص الكامل النظيف (الصفحات مفصولة بسطر فارغ)"}
  }
}
